# ---------------------------------------------------------------------------
# FieldTrace backend configuration. Copy to `.env` and fill in real values.
# Never commit `.env`.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# MongoDB connection string (local mongod or MongoDB Atlas).
MONGODB_URI=mongodb://127.0.0.1:27017/fieldtrace

# Secret used to sign access tokens (HS256). Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Access token lifetime in seconds (default 15 minutes).
JWT_ACCESS_TTL_SEC=900
# Refresh token / session lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# In-memory store (no Redis/Docker needed) or redis://127.0.0.1:6380
REDIS_URL=memory
# Prefix for every key, so several apps/environments can share a Redis safely.
REDIS_KEY_PREFIX=ft:

# Comma-separated list of browser origins allowed to call the API (and Socket.IO) with credentials.
# Frontend (Vite) runs on 3000.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Refresh cookie flags. In production behind HTTPS use COOKIE_SECURE=true.
# Use COOKIE_SAMESITE=none only if the frontend is served from a different *site* (requires secure).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set to the number of proxy hops (e.g. 1) when running behind a reverse proxy / load balancer.
TRUST_PROXY=0

# Max auth attempts (login/register/refresh) per IP per minute.
AUTH_RATE_LIMIT_PER_MIN=10

# Password used by `npm run seed` for every seeded demo account. Dev only.
SEED_DEFAULT_PASSWORD=

# --- Telemetry ingestion (Phase 2) ---
# Max GPS samples per POST /telemetry.
TELEMETRY_MAX_BATCH=50
# Reject samples older than this (seconds) or more than SKEW seconds in the future.
TELEMETRY_MAX_AGE_SEC=86400
TELEMETRY_MAX_FUTURE_SKEW_SEC=120
# Raw location history TTL in days (MongoDB time-series collection; set before first start).
TELEMETRY_RETENTION_DAYS=90
# How often online/stale/offline status is re-evaluated (seconds).
STATUS_SWEEP_INTERVAL_SEC=15
