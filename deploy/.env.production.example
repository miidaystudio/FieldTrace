# Production environment for deploy/docker-compose.yml (copy to .env.production; never commit it).

# --- required
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/fieldtrace
# 48+ random bytes: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Public origin(s) of the dashboard
CORS_ORIGINS=https://fieldtrace.example.com
APP_URL=https://fieldtrace.example.com
# HTTPS is required in production
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- optional integrations
# Road travel times and route geometry (otherwise straight-line estimates)
ORS_API_KEY=
# Email alerts (otherwise emails are only logged)
RESEND_API_KEY=
EMAIL_FROM=FieldTrace <alerts@fieldtrace.example.com>

# --- retention
TELEMETRY_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=0
NOTIFICATION_RETENTION_DAYS=90

LOG_LEVEL=info
